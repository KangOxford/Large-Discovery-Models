[run]
branch = True
include =
    ldm_tts/*
    tasks/nanogpt/core/expansion_schema.py
    tasks/nanogpt/core/search_core.py
    tasks/nanogpt/core/single_search.py
    tasks/nanogpt/resources/train/mock_train.py

[report]
fail_under = 80
show_missing = True
skip_empty = True
precision = 1
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    \.\.\.
