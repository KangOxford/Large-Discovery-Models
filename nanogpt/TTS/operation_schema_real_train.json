{
  "version": "real_train_knobs_v1",
  "description": "Fixed operation space for constrained model-based search over TTS/real_train.py top-level hyperparameter assignments.",
  "parameters": {
    "ASPECT_RATIO": {
      "type": "int",
      "min": 32,
      "max": 128
    },
    "HEAD_DIM": {
      "type": "choice",
      "choices": [64, 96, 128]
    },
    "WINDOW_PATTERN": {
      "type": "choice",
      "choices": ["SSSS", "SSSL", "SSLL", "SLSL", "SLLL", "LLLL"]
    },
    "TOTAL_BATCH_SIZE": {
      "type": "choice",
      "choices": [262144, 524288, 1048576]
    },
    "EMBEDDING_LR": {
      "type": "float",
      "min": 0.1,
      "max": 1.0,
      "scale": "log"
    },
    "UNEMBEDDING_LR": {
      "type": "float",
      "min": 0.001,
      "max": 0.02,
      "scale": "log"
    },
    "MATRIX_LR": {
      "type": "float",
      "min": 0.01,
      "max": 0.1,
      "scale": "log"
    },
    "SCALAR_LR": {
      "type": "float",
      "min": 0.05,
      "max": 1.0,
      "scale": "log"
    },
    "WEIGHT_DECAY": {
      "type": "float",
      "min": 0.0,
      "max": 0.5,
      "scale": "linear"
    },
    "WARMUP_RATIO": {
      "type": "float",
      "min": 0.0,
      "max": 0.2,
      "scale": "linear"
    },
    "WARMDOWN_RATIO": {
      "type": "float",
      "min": 0.0,
      "max": 0.95,
      "scale": "linear"
    },
    "FINAL_LR_FRAC": {
      "type": "float",
      "min": 0.0,
      "max": 0.2,
      "scale": "linear"
    },
    "DEPTH": {
      "type": "int",
      "min": 2,
      "max": 16
    },
    "DEVICE_BATCH_SIZE": {
      "type": "choice",
      "choices": [32, 64, 96, 128]
    }
  }
}
