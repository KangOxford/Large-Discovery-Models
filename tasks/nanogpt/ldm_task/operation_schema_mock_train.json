{
  "version": "mock_train_knobs_v1",
  "description": "Fixed operation space for constrained model-based search tests over ldm_task/mock_train.py top-level mock hyperparameter assignments.",
  "parameters": {
    "DEPTH": {
      "type": "int",
      "min": 1,
      "max": 16
    },
    "WIDTH": {
      "type": "choice",
      "choices": [256, 384, 512, 640, 704, 768, 896]
    },
    "MATRIX_LR": {
      "type": "float",
      "min": 0.005,
      "max": 0.05,
      "scale": "log"
    },
    "EMBEDDING_LR": {
      "type": "float",
      "min": 0.1,
      "max": 1.0,
      "scale": "log"
    },
    "WEIGHT_DECAY": {
      "type": "float",
      "min": 0.0,
      "max": 0.4,
      "scale": "linear"
    },
    "VALUE_GATE_CHANNELS": {
      "type": "choice",
      "choices": [16, 32, 48, 64, 80, 96]
    },
    "WARMDOWN_RATIO": {
      "type": "float",
      "min": 0.0,
      "max": 0.9,
      "scale": "linear"
    },
    "NGRAM_SCALE": {
      "type": "float",
      "min": 0.05,
      "max": 0.3,
      "scale": "linear"
    }
  }
}
