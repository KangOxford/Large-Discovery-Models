  "counter_code_current": "def _compute_zero_std_metrics(args, all_samples: list[Sample]):\n    # only compute in GRPO-like algorithms where one prompt has multiple responses\n    if args.advantage_estimator == \"ppo\":\n        return {}\n\n    def _group_rewards(samples: list[Sample]):\n        return [sample.get_reward_value(args) for sample in samples]\n\n    mode = getattr(args, \"grpo_advantage_std_mode\", DEFAULT_ADVANTAGE_STD_MODE)\n\n    def _is_zero_std(samples: list[Sample]):\n        rewards = _group_rewards(samples)\n        return len(rewards) == 0 or all(rewards[0] == r for r in rewards)\n\n    def _is_below_eps_std(samples: list[Sample]):\n        # `_is_zero_std` only catches exact float ties, but `_post_process_rewards` divides\n        # by `std + _ADVANTAGE_STD_EPS`. A group whose rewards differ only by float residue\n        # (e.g. a `max(0.0, ...)` reward landing on 5e-13) keeps a nonzero std, so the exact\n        # check never sees it, yet its advantages come out at ~eps of full scale: no usable\n        # gradient. Mirror the training-side computation (same float32 cast, same unbiased\n        # std) so the two cannot drift apart.\n        rewards = _group_rewards(samples)\n        if len(rewards) < 2:\n            return True\n        std = torch.tensor(rewards, dtype=torch.float).std().item()\n        return not np.isfinite(std) or std < _ADVANTAGE_STD_EPS\n\n    def _is_degenerate_std(samples: list[Sample]):\n        # The set `normalize_by_group_std` sends to exactly 0.0 in \"scale_free\" mode:\n        # fewer than two samples, or a std that is not finite and strictly positive.\n        rewards = _group_rewards(samples)\n        if len(rewards) < 2:\n            return True\n        std = torch.tensor(rewards, dtype=group_stat_dtype(mode)).std().item()\n        return not np.isfinite(std) or std <= 0.0\n\n    all_sample_groups = group_by(all_samples, lambda s: s.group_index)\n    interesting_sample_groups = [g for g in all_sample_groups.values() if _is_zero_std(g)]\n\n    interesting_rewards = [str(round(g[0].get_reward_value(args), 1)) for g in interesting_sample_groups]\n\n    metrics = {f\"zero_std/count_{reward}\": len(items) for reward, items in group_by(interesting_rewards).items()}\n    # emitted on every rollout, zero included: a missing key cannot be told apart from\n    # \"this was never measured\", which is exactly how the exact-equality count read.\n    metrics[\"zero_std/count_lt_eps\"] = sum(1 for g in all_sample_groups.values() if _is_below_eps_std(g))\n    # `count_lt_eps` is only the gradient-killing set under `legacy_eps`. Under\n    # `scale_free` a sub-eps std is normalized like any other, so the set that really\n    # carries no gradient is the exactly-degenerate one. Report the count that matches\n    # the running mode, and label it with that mode so the two cannot be confused when\n    # comparing runs recorded on either side of the flag.\n    degenerate = _is_below_eps_std if mode == \"legacy_eps\" else _is_degenerate_std\n    metrics[\"zero_std/count_no_gradient\"] = sum(1 for g in all_sample_groups.values() if degenerate(g))\n    metrics[\"zero_std/mode_is_scale_free\"] = float(mode == \"scale_free\")\n    return metrics",
